# MongoDB Atlas connection string (free M0 tier). Section 8 / 13.4.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flysmart?retryWrites=true&w=majority

# SerpApi (Google Flights) key — primary flight data source. Section 10.1.
SERPAPI_KEY=

# Duffel API key — fallback flight data source. Not required for Phase 1. Section 10.2.
DUFFEL_API_KEY=

# Telegram bot — not required until Phase 2 (notifications). Section 11.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PORT=3001
